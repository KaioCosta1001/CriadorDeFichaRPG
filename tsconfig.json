{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    /* ── Blindagem extra exigida pelo projeto (seção 2/16: "sem any") ─────
     * `exactOptionalPropertyTypes` foi DEIXADO DE FORA de propósito: ele
     * conflita com as declarações de tipo de MUI/react-hook-form/Zod
     * (`prop?: T` vs `prop?: T | undefined`) e geraria ruído sem
     * melhorar a segurança do nosso código. Reavaliar se o projeto deixar
     * de usar esses pacotes. */
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    /* ── Build ──────────────────────────────────────────────────────────── */
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "verbatimModuleSyntax": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
